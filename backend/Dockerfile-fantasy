# golang:1 is always the newest Go release; go.mod sets the minimum
FROM golang:1 AS compiler

COPY apps/fantasy /src/fantasy/

WORKDIR /src/fantasy

# The version comes from the git tags on the commit (apps/fantasy/scripts/version.sh):
#   docker build --build-arg VERSION="$(apps/fantasy/scripts/version.sh)" -f Dockerfile-fantasy .
# Without it the binary reports "dev"
ARG VERSION=dev

RUN go mod download && CGO_ENABLED=0 go build \
    -ldflags "-s -w -X bitbucket.org/daforester/go-audience/apps/fantasy/setup.Version=${VERSION}" \
    -o /go/bin/fantasy ./cmd/fantasy.go

RUN mkdir /data

FROM gcr.io/distroless/static-debian13:nonroot

COPY --from=compiler /go/bin/fantasy /fantasy

COPY config-fantasy.toml /config.toml

COPY --from=compiler --chown=65532:65532 /data /data

USER nonroot

ENTRYPOINT ["/fantasy", "-config", "/config.toml", "-root", "/", "-state", "/data/fantasy-game.dat"]
